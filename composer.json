{
	"name": "donut-org/donut-gui",
	"description": "Autorské prostředí pro workflow donutu",
	"license": "BSD-3-Clause",
	"type": "project",
	"repositories": [
		{"type": "path", "url": "../"}
	],
	"require": {
		"php": ">=8.1",
		"donut-org/donut": "*",
		"nette/application": "^3.2",
