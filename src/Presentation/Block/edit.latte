{block title}{$name ?? 'Nový kámen'} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Block:default">Kameny</a></li>
	<li n:if="$name !== null" class=breadcrumb-item><a n:href="Block:detail, name: $name">{$name}</a></li>
	<li class="breadcrumb-item active" aria-current=page>{$name === null ? 'nový kámen' : 'úprava'}</li>
{/block}

{block content}
<h1>{$name ?? 'Nový kámen'}</h1>

<p n:if="$error" class="alert alert-danger">{$error}</p>

{if !$error}
	<div n:if="$errors" class="alert alert-danger">
		<ul class="mb-0">
			<li n:foreach="$errors as $err">{$err}</li>
		</ul>
	</div>

	<div n:if="$warnings" class="alert alert-warning">
		<ul class="mb-0">
			<li n:foreach="$warnings as $warning">{$warning}</li>
		</ul>
	</div>

	{form blockForm}
		<div n:if="$form->getErrors()" class="alert alert-danger">
			<ul class="mb-0">
				<li n:foreach="$form->getErrors() as $err">{$err}</li>
			</ul>
		</div>

		<div class="card mb-3">
			<div class="card-body">
				<p>{label name /} {input name}</p>
				<p>{label description /} {input description}</p>
				<p>{label command /} {input command}</p>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Argumenty</div>
			<div class="card-body">
				<p class=keys>Skupina, ve které se proměnná vyhodnotí na prázdno, vypadne celá.</p>

				{* Vodorovný tvar skupiny: form-control z FormFactory je display:block
				   na celou šířku, takže bez tohohle by z argumentů byl svislý sloupec
				   stejně vypadajících políček a hranice skupiny by zmizela. Třída
				   se sem píše celá i s form-control — ochrana ve FormFactory (doplní
				   třídu jen tam, kde žádná není) se tu neuplatní, protože {input}
				   s class => … atribut class přepíše celý; kdyby form-control
				   v tomhle řetězci chybělo, v HTML by chybělo taky. *}
				<div id=args>
					<div class="arg-group d-flex flex-wrap align-items-center gap-2 mb-2 border rounded p-2" n:foreach="$form['args']->getComponents() as $group">
						<span n:foreach="$group->getComponents() as $arg">{input $arg, class => 'form-control w-auto'}</span>
						<button type=button class="btn btn-sm btn-secondary add-arg">+ argument</button>
						<button type=button class="btn btn-sm btn-outline-danger del-group">× skupina</button>
					</div>
				</div>

				<button type=button class="btn btn-sm btn-secondary" id=add-group>+ skupina</button>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Vstupy</div>
			<div class="card-body">
				{* table-responsive a aria-label doslova jako ve Workflow/edit.latte —
				   je to táž tabulka vstupů. *}
				<div class=table-responsive>
					<table class="table table-sm align-middle">
						<thead>
							<tr>
								<th scope=col>Jméno</th>
								<th scope=col>Povinný</th>
								<th scope=col>Výchozí</th>
								<th scope=col>Popis</th>
								<th scope=col><span class=visually-hidden>Smazat řádek</span></th>
							</tr>
						</thead>
						<tbody id=inputs>
							<tr class=js-row n:foreach="$form['inputs']->getComponents() as $row">
								<td>{input $row['name']}</td>
								<td>{input $row['required']}</td>
								<td>{input $row['default']}</td>
								<td>{input $row['description']}</td>
								<td><button type=button class="btn btn-sm btn-outline-danger js-del-row" aria-label="Smazat řádek">×</button></td>
							</tr>
						</tbody>
					</table>
				</div>

				<button type=button class="btn btn-sm btn-secondary" data-add=inputs>+ vstup</button>

				<p class=form-text>
					Výchozí hodnota se použije, když ji volající nepředá.
					Na příkazové řádce se vstup zadává jako <code>--jmeno=hodnota</code>.
				</p>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Stdin</div>
			<div class="card-body">
				<p>{input hasStdin} {label hasStdin /}</p>
				<p>{input stdinRequired} {label stdinRequired /}</p>
				<p>{label stdinDescription /} {input stdinDescription}</p>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Ostatní</div>
			<div class="card-body">
				<p>{label timeout /} {input timeout}</p>
				<p>{label allowFailure /} {input allowFailure} {input allowFailureCodes}</p>
			</div>
		</div>

		<p>{input save}</p>
	{/form}

	{* Skupiny argumentů jsou dvouúrovňové (args[g][a]) — sdílený mechanismus
	   z rows.js zvládá jen jednu úroveň, takže args zůstává na vlastním
	   kódu. Používá ale jeho maxIndex a cloneRow. *}
	<script n:syntax="off">
	document.getElementById('add-group').addEventListener('click', () => {
		const box = document.getElementById('args');
		const rows = box.querySelectorAll('.arg-group');
		const next = maxIndex(box.querySelectorAll('input'), /^args\[(\d+)]/) + 1;
		box.appendChild(cloneRow(
			rows[rows.length - 1],
			n => n.replace(/^args\[\d+]/, 'args[' + next + ']')
		));
	});

	document.addEventListener('click', e => {
		if (e.target.classList.contains('add-arg')) {
			const group = e.target.closest('.arg-group');
			const first = group.querySelector('span');
			const g = /^args\[(\d+)]/.exec(first.querySelector('input').getAttribute('name'))[1];
			const next = maxIndex(group.querySelectorAll('input'), /^args\[\d+]\[(\d+)]/) + 1;
			group.insertBefore(
				cloneRow(first, n => 'args[' + g + '][' + next + ']'),
				e.target
			);
		}

		if (e.target.classList.contains('del-group')) {
			const box = document.getElementById('args');
			if (box.querySelectorAll('.arg-group').length > 1) e.target.closest('.arg-group').remove();
		}
	});
	</script>
{/if}

{if $name !== null}
	<div class="card border-danger mb-3">
		<div class="card-header text-danger">Smazat</div>
		<div class="card-body">
			{if $usedBy}
				<p class=keys>
					Nejde smazat — používá ho: {implode(', ', $usedBy)}.
				</p>
			{else}
				{form deleteForm}
					<div n:if="$form->getErrors()" class="alert alert-danger">
						<ul class="mb-0">
							<li n:foreach="$form->getErrors() as $err">{$err}</li>
						</ul>
					</div>

					<input type=hidden n:name=name value="{$name}">
					{* Jméno se do confirm() nedává schválně: Latte hodnotu v JS
					   kontextu json-enkóduje a v dialogu by byla v uvozovkách navíc.
					   Escapování se nevypíná, text se přeformuloval. *}
					<button type=submit n:name=delete onclick="return confirm('Opravdu smazat tenhle kámen?')">Smazat</button>
				{/form}
			{/if}
		</div>
	</div>
{/if}
