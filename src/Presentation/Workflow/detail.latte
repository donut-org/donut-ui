{import 'steps.latte'}

{block title}{if $workflow === null}Error{else}{$workflow->name}{/if} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Workflow:default">Workflows</a></li>
	{* For a broken file, the name from the address is the only thing that
	   tells the user which workflow failed to parse — "Error" wouldn't tell
	   them anything. *}
	<li class="breadcrumb-item active" aria-current=page>{$workflow !== null ? $workflow->name : $name}</li>
{/block}

{block content}
{* The error is reported even when the workflow did load — missing blocks
   take validation down, not the whole page. Without a workflow, only the
   message is left. *}
<p n:if="$error" class="alert alert-danger">{$error}</p>

<h1 n:if="$workflow !== null">{$workflow->name}</h1>

{* The link to edit the header sits outside the condition on purpose: a
   broken workflow is the one the user most needs a path to fix or delete
   for. Block:detail has the same rule. The name comes from the address, not
   from the loaded workflow — a file that failed to parse has no loaded
   workflow, and is looked up the same way, by the name from the address. *}
<p><a n:href="Workflow:edit, name: $name" class="btn btn-primary">edit header</a></p>

{if $workflow !== null}
	<p n:if="$workflow->description">{$workflow->description}</p>

	{foreach $workflowProblems as $problem}
		{include problem, problem: $problem}
	{/foreach}

	<h2 n:if="$workflow->inputs">Inputs</h2>
	<ul n:if="$workflow->inputs">
		<li n:foreach="$workflow->inputs as $input">
			<code>--{$input->name}=</code>
			{$input->required ? 'required' : 'optional'}
			{if $input->default !== null}(default <code>{$input->default}</code>){/if}
			{$input->description}
		</li>
	</ul>

	<p n:if="$selectedKey !== null">
		Selected key: <code>{$selectedKey}</code>
		<a n:href="this, key: null">clear selection</a>
		<span n:if="!$selectedKeyExists" class=text-warning>— this key does not occur in the workflow</span>
	</p>

	<h2>Steps</h2>
	{control stepTree, $workflow, $problems, $keys, $selectedKey}
{/if}
