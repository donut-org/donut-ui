{
  "name": "curl-get",
  "description": "HTTP GET. Tělo odpovědi jde na stdout.",
  "command": "curl",
  "args": [
    [
      "-sS",
      "--fail"
    ],
    [
      "--config",
      "{%curlrc%}"
    ],
    [
      "{%url%}"
    ]
  ],
  "inputs": {
    "url": {
      "required": true,
      "description": "Úplná adresa včetně query stringu"
    },
    "curlrc": {
      "required": false,
      "description": "Soubor s přihlašovací hlavičkou (curl --config)"
    }
  }
}
