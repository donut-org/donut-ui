{block content}
<h1>Workflow</h1>

<ul n:if="$workflows">
	<li n:foreach="$workflows as $name => $workflow">
		{if is_string($workflow)}
			<strong>{$name}</strong> — <span class=error>{$workflow}</span>
		{else}
			<a n:href="detail $name">{$name}</a>
			{$workflow->description}
		{/if}
	</li>
</ul>

<p n:if="!$workflows">V adresáři <code>{Donut\Gui\Presentation\Workflow\WorkflowPresenter::projectDir()}/workflows</code> nic není.</p>

<p><a n:href="Block:default">Kameny</a></p>
