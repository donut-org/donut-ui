<!DOCTYPE html>
<html lang=cs>
<meta charset=utf-8>
<title>{block title}Donut{/block}</title>
<style>
	body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem; max-width: 60rem }
	.error { color: #a00 }
	.warning { color: #a60 }
	code { background: #f4f4f4; padding: .1em .3em }
	li.write { background: #eafbea }
	li.read { background: #eef3fb }
	li.write.read { background: #f4f0e6 }
	.keys { font-size: .85em; color: #666 }
	.keys a { color: #06c }
</style>
{include content}
