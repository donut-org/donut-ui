{import 'steps.latte'}

{block title}{if $workflow === null}Chyba{else}{$workflow->name}{/if} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Workflow:default">Workflow</a></li>
	{* U rozbitého souboru je jméno z adresy to jediné, co uživateli řekne,
	   které workflow se nenaparsovalo — „chyba" mu neřekne nic. *}
	<li class="breadcrumb-item active" aria-current=page>{$workflow !== null ? $workflow->name : $name}</li>
{/block}

{block content}
{* Chyba se hlásí i tehdy, když workflow načíst šlo — chybějící kameny berou
   validaci, ne celou stránku. Bez workflow zbývá jen hláška. *}
<p n:if="$error" class=error>{$error}</p>

{if $workflow !== null}
	<h1>{$workflow->name}</h1>
	<p><a n:href="Workflow:edit, name: $workflow->name">upravit hlavičku</a></p>
	<p n:if="$workflow->description">{$workflow->description}</p>

	{foreach $workflowProblems as $problem}
		{include problem, problem: $problem}
	{/foreach}

	<h2 n:if="$workflow->inputs">Vstupy</h2>
	<ul n:if="$workflow->inputs">
		<li n:foreach="$workflow->inputs as $input">
			<code>--{$input->name}=</code>
			{$input->required ? 'povinný' : 'volitelný'}
			{if $input->default !== null}(výchozí <code>{$input->default}</code>){/if}
			{$input->description}
		</li>
	</ul>

	<p n:if="$selectedKey !== null">
		Vybraný klíč: <code>{$selectedKey}</code>
		<a n:href="this, key: null">zrušit výběr</a>
		<span n:if="!$selectedKeyExists" class=warning>— tento klíč se ve workflow nevyskytuje</span>
	</p>

	<h2>Kroky</h2>
	{control stepTree, $workflow, $problems, $keys, $selectedKey}
{/if}
