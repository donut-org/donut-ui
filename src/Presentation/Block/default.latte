{block title}Blocks — Donut{/block}

{block breadcrumbs}
	<li class="breadcrumb-item active" aria-current=page>Blocks</li>
{/block}

{block content}
<h1>Blocks</h1>

<p><a n:href="Block:edit" class="btn btn-primary">+ new block</a></p>

{* The message, including the `mkdir blocks` hint, arrives ready-made from
   renderDefault(), same as on Workflow:detail. *}
<p n:if="$error" class="alert alert-danger">{$error}</p>
<p n:if="!$error && !$blocks">There are no blocks in <code>{$dir}</code>.</p>

<div class=table-responsive n:if="$blocks">
	<table class="table table-sm align-middle">
		<thead>
			<tr>
				<th scope=col>Name</th>
				{* Description is the second column, same as for workflows: the
				   command alone doesn't distinguish blocks (in a real project 9
				   of 15 share it), the description does. *}
				<th scope=col>Description</th>
				<th scope=col>Command</th>
				<th scope=col>Used by</th>
				<th scope=col><span class=visually-hidden>Actions</span></th>
			</tr>
		</thead>
		<tbody>
			<tr n:foreach="$blocks as $name => $block">
				<td>
					{if is_string($block)}
						<strong>{$name}</strong>
					{else}
						<a n:href="Block:detail, name: $name">{$name}</a>
					{/if}
				</td>
				{* The broken block's message sits in the second column, same as
				   for a broken workflow; the other columns stay empty for such a
				   row, because there's nowhere for them to come from. *}
				<td>
					{if is_string($block)}
						<span class=text-danger>{$block}</span>
					{else}
						{$block->description}
					{/if}
				</td>
				<td>
					{if !is_string($block)}
						<code>{$block->command}</code>
					{/if}
				</td>
				<td>{if isset($usage[$name])}{implode(', ', $usage[$name])}{/if}</td>
				{* The edit link sits outside the condition on purpose: a block that
				   fails to parse is the one whose user needs the path to fixing
				   and deleting most. Workflow/default.latte does the same.

				   aria-label tells the links apart: in a screen reader's list of
				   links it would otherwise say "edit" as many times as the table
				   has rows, with no way to tell which is which. The bar was set
				   by aria-label="Delete row" on the row buttons. *}
				<td><a n:href="Block:edit, name: $name" class="btn btn-primary btn-sm" aria-label="Edit block {$name}">edit</a></td>
			</tr>
		</tbody>
	</table>
</div>
