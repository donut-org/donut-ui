{block title}{$name ?? 'New workflow'} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Workflow:default">Workflows</a></li>
	<li n:if="$name !== null" class=breadcrumb-item><a n:href="Workflow:detail, name: $name">{$name}</a></li>
	<li class="breadcrumb-item active" aria-current=page>{$name === null ? 'new workflow' : 'header'}</li>
{/block}

{block content}
<h1>{$name ?? 'New workflow'}</h1>

<p n:if="$error" class="alert alert-danger">{$error}</p>

{if !$error}
	{form headerForm}
		<div n:if="$form->getErrors()" class="alert alert-danger">
			<ul class="mb-0">
				<li n:foreach="$form->getErrors() as $err">{$err}</li>
			</ul>
		</div>

		<div class="card mb-3">
			<div class="card-body">
				<p>{label name /} {input name}</p>
				<p>{label description /} {input description}</p>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Inputs</div>
			<div class="card-body">
				{* table-responsive: on a narrow window the table scrolls
				   horizontally instead of squeezing the columns down to a few
				   characters.
				   The accessible name of the fields (aria-label) is added by the
				   presenter — it's a label like any other, and in this GUI it
				   lives at addText(). *}
				<div class=table-responsive>
					<table class="table table-sm align-middle">
						<thead>
							<tr>
								<th scope=col>Name</th>
								<th scope=col>Required</th>
								<th scope=col>Default</th>
								<th scope=col>Description</th>
								<th scope=col><span class=visually-hidden>Delete row</span></th>
							</tr>
						</thead>
						<tbody id=inputs>
							<tr class=js-row n:foreach="$form['inputs']->getComponents() as $row">
								<td>{input $row['name']}</td>
								<td>{input $row['required']}</td>
								<td>{input $row['default']}</td>
								<td>{input $row['description']}</td>
								<td><button type=button class="btn btn-sm btn-outline-danger js-del-row" aria-label="Delete row">×</button></td>
							</tr>
						</tbody>
					</table>
				</div>

				<button type=button class="btn btn-sm btn-secondary" data-add=inputs>+ input</button>

				<p class=form-text>
					The default value is used when the caller does not pass one.
					On the command line an input is given as <code>--name=value</code>.
				</p>
			</div>
		</div>

		<p>{input save}</p>
	{/form}
{/if}

{* Deletion sits outside {if !$error} on purpose: a workflow whose file fails
   to parse is the one the user most needs to be able to remove. Literally
   like Block/edit.latte. *}
{if $name !== null}
	<div class="card border-danger mb-3">
		<div class="card-header text-danger">Delete</div>
		<div class="card-body">
			<p class=keys>
				The workflow runs by name from cron and the CLI, which this tool
				cannot see — check that nothing else runs it.
			</p>

			{form deleteWorkflowForm}
				<div n:if="$form->getErrors()" class="alert alert-danger">
					<ul class="mb-0">
						<li n:foreach="$form->getErrors() as $err">{$err}</li>
					</ul>
				</div>

				<input type=hidden n:name=name value="{$name}">
				{* The name isn't passed to confirm() on purpose — in a JS context
				   Latte JSON-encodes it, and the dialog would have it in extra
				   quotes. *}
				<button type=submit n:name=save onclick="return confirm('Really delete this workflow?')">Delete</button>
			{/form}
		</div>
	</div>
{/if}
