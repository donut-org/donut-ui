{import 'steps.latte'}

{block content}
<p><a n:href="default">← workflow</a></p>

{if $error}
	<p class=error>{$error}</p>
{else}
	<h1>{$workflow->name}</h1>
	<p n:if="$workflow->description">{$workflow->description}</p>

	<div n:foreach="$workflowProblems as $problem" class="{$problem->severity === Donut\Validator\Problem::Error ? 'error' : 'warning'}">
		{$problem->severity === Donut\Validator\Problem::Error ? '✕' : '⚠'} {$problem->message}
	</div>

	<h2 n:if="$workflow->inputs">Vstupy</h2>
	<ul n:if="$workflow->inputs">
		<li n:foreach="$workflow->inputs as $input">
			<code>--{$input->name}=</code>
			{$input->required ? 'povinný' : 'volitelný'}
			{if $input->default !== null}(výchozí <code>{$input->default}</code>){/if}
			{$input->description}
		</li>
	</ul>

	<h2>Kroky</h2>
	{include steps, steps: $workflow->steps, path: $rootPath, problems: $problems}
{/if}
