{block title}{$name} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Block:default">Blocks</a></li>
	<li class="breadcrumb-item active" aria-current=page>{$name}</li>
{/block}

{block content}
<h1>{$name}</h1>

{* The edit link sits outside the condition on purpose: a broken block is the
   one whose user needs the path to fixing and deleting most. *}
<p><a n:href="Block:edit, name: $name" class="btn btn-primary">edit</a></p>

<p n:if="$error" class="alert alert-danger">{$error}</p>

{if $block !== null}
	<p n:if="$block->description">{$block->description}</p>

	<p>command: <code>{$block->command}</code></p>

	<h2 n:if="$block->args">Arguments</h2>
	<ul n:if="$block->args">
		<li n:foreach="$block->args as $group">
			{foreach $group as $arg}<code>{$arg->getSource()}</code>{sep} {/sep}{/foreach}
		</li>
	</ul>

	<h2 n:if="$block->inputs">Inputs</h2>
	<ul n:if="$block->inputs">
		<li n:foreach="$block->inputs as $input">
			<code>{$input->name}</code>
			{$input->required ? 'required' : 'optional'}
			{if $input->default !== null}(default <code>{$input->default}</code>){/if}
			{$input->description}
		</li>
	</ul>

	<p n:if="$block->stdin">
		reads <strong>stdin</strong> —
		{$block->stdin->required ? 'required' : 'optional'}
		{$block->stdin->description}
	</p>

	<p n:if="$block->timeout !== null">timeout: {$block->timeout} s</p>
	<p n:if="$block->allowFailure !== false">
		allow_failure: {is_array($block->allowFailure) ? implode(', ', $block->allowFailure) : 'any exit code'}
	</p>

{/if}

{* "Used by" sits outside the condition on purpose: $usedBy is computed from
   the workflows, not the block, so it's known even for a broken file — and
   right before fixing or deleting it, the list of workflows that call the
   block is the most important information. *}
<h2 n:if="$usedBy">Used by</h2>
<ul n:if="$usedBy">
	<li n:foreach="$usedBy as $workflow">{$workflow}</li>
</ul>
