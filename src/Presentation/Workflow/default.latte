{block content}
<h1>Workflow</h1>

<p n:if="$error" class=error>{$error}</p>
<p n:if="!$error && !$workflows">V adresáři <code>{$dir}</code> žádná workflow nejsou.</p>

<ul n:if="$workflows">
	<li n:foreach="$workflows as $name => $workflow">
		{if is_string($workflow)}
			<strong>{$name}</strong> — <span class=error>{$workflow}</span>
		{else}
			<a n:href="detail $name">{$name}</a>
			{$workflow->description}
		{/if}
	</li>
</ul>

<p><a n:href="Block:default">Kameny</a></p>
