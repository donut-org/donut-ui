{* Severita → CSS třída a ikona na jednom místě, ne dvakrát opsané. *}
{define problem, Donut\Validator\Problem $problem}
<div class="{$problem->severity === Donut\Validator\Problem::Error ? 'text-danger' : 'text-warning'}">
	{$problem->severity === Donut\Validator\Problem::Error ? '✕' : '⚠'} {$problem->message}
</div>
{/define}


{define steps, array $steps, Donut\Gui\StepPath $path, Donut\Gui\ProblemMap $problems, Donut\Gui\KeyMap $keys, ?string $selected, string $name}
<div class="list-group">
	{foreach $steps as $i => $step}
		{var $at = $path->index($i)}
		{* Kolik kroků zmizí spolu s tímhle — rekurzivně, i s vnořenými
		   then/else/steps, jinak by potvrzení mazání číslo podhodnotilo. *}
		{var $subtree = Donut\Gui\StepCount::subtree($step)}
		<div class="list-group-item">
			{* Třída patří jen řádku kroku, ne položce seznamu — ta obaluje
			   i vnořený .list-group s tělem then/else/foreach a background
			   by se přenesl na celý podstrom. *}
			<div n:class="step, $keys->classAt($at, $selected)">
				<div class="d-flex gap-1 align-items-center float-end">
					{* btn-group tu nejde: očekává tlačítka jako přímé
					   sourozence, ale tři ze čtyř sedí každý ve vlastním
					   <form> — Nette komponentu nelze renderovat uvnitř
					   n:foreach, takže formuláře musí zůstat ruční. *}
					<a class="btn btn-sm btn-outline-secondary" href="{plink Workflow:step, name: $name, at: (string) $at}">upravit</a>

					<form n:if="$i > 0" method=post action="{link moveUp!}" class="d-inline">
						<input type=hidden name=at value="{$at}">
						<button type=submit class="btn btn-sm btn-outline-secondary" aria-label="Posunout nahoru">↑</button>
					</form>

					<form n:if="$i < count($steps) - 1" method=post action="{link moveDown!}" class="d-inline">
						<input type=hidden name=at value="{$at}">
						<button type=submit class="btn btn-sm btn-outline-secondary" aria-label="Posunout dolů">↓</button>
					</form>

					<form method=post action="{link deleteStep!}" class="d-inline">
						<input type=hidden name=at value="{$at}">
						<button type=submit class="btn btn-sm btn-outline-danger" aria-label="Smazat krok" n:attr="onclick => $subtree
							? 'return confirm(\'Smazat i ' . Donut\Gui\StepCount::label($subtree) . '?\')'
							: null">×</button>
					</form>
				</div>

				{if $step instanceof Donut\Format\RunStep}
					<strong>run</strong> {$step->block}
					{if $step->name} — {$step->name}{/if}
					<ul n:if="$step->in">
						<li n:foreach="$step->in as $key => $template">{$key}: <code>{$template->getSource()}</code></li>
					</ul>
					<ul n:if="$step->out">
						<li n:foreach="$step->out as $channel => $key">{$channel} → <code>{$key}</code></li>
					</ul>

				{elseif $step instanceof Donut\Format\SetStep}
					<strong>set</strong> <code>{$step->key}</code> = <code>{$step->value->getSource()}</code>
					{if $step->name} — {$step->name}{/if}

				{elseif $step instanceof Donut\Format\IfStep}
					<strong>if</strong>
					<code>{$step->condition->left->getSource()}</code>
					{$step->condition->op}
					{if $step->condition->right}<code>{$step->condition->right->getSource()}</code>{/if}
					{if $step->name} — {$step->name}{/if}

				{elseif $step instanceof Donut\Format\ForeachStep}
					<strong>foreach</strong>
					<code>{$step->over->getSource()}</code> as <code>{$step->as}</code>
					{if $step->name} — {$step->name}{/if}
				{/if}

				{foreach $problems->at($at) as $problem}
					{include problem, problem: $problem}
				{/foreach}

				{var $reads = $keys->readsAt($at)}
				{var $writes = $keys->writesAt($at)}
				<div class=keys n:if="$reads || $writes">
					<span n:if="$reads">čte
						{foreach $reads as $k}<a href="{plink this, key: $k}">{$k}</a>{sep}, {/sep}{/foreach}</span>{if $reads && $writes}, {/if}<span n:if="$writes">zapisuje
						{foreach $writes as $k}<a href="{plink this, key: $k}">{$k}</a>{sep}, {/sep}{/foreach}</span>
				</div>
			</div>

			{if $step instanceof Donut\Format\IfStep}
				<h3 class="h6 text-muted mt-2 mb-1">then</h3>
				{include steps, steps: $step->then, path: $at->child('then'), problems: $problems, keys: $keys, selected: $selected, name: $name}
				<h3 class="h6 text-muted mt-2 mb-1">else</h3>
				{include steps, steps: $step->else, path: $at->child('else'), problems: $problems, keys: $keys, selected: $selected, name: $name}
			{elseif $step instanceof Donut\Format\ForeachStep}
				{include steps, steps: $step->steps, path: $at->child('steps'), problems: $problems, keys: $keys, selected: $selected, name: $name}
			{/if}
		</div>
	{/foreach}

	<div class="list-group-item">
		+ krok:
		{foreach ['run', 'set', 'if', 'foreach'] as $type}
			<a href="{plink Workflow:step, name: $name, at: (string) $path->index(count($steps)), type: $type}">{$type}</a>{sep} {/sep}
		{/foreach}
	</div>
</div>
{/define}
