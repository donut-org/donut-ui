application:
	mapping:
		*: Donut\Gui\Presentation\*\**Presenter

	# Without catchExceptions the error presenter is not even wired in debug
	# mode (ApplicationExtension gates it on `catchExceptions || !debugMode`),
	# so a 404 would reach Tracy instead of a page. ErrorPresenter handles 4xx
	# and rethrows everything else, which Application::run() then rethrows in
	# turn — so real crashes still get their bluescreen.
	catchExceptions: true
	errorPresenter: Error

services:
	# Where blocks and workflows live. The environment is read when the server
	# starts, as in the CLI — the GUI does not switch profiles at runtime;
	# switching means a restart with a different variable.
	- Donut\Profile::fromEnvironment(::getenv())

	# SimpleRouter is enough: URLs live in the query string
	# (?presenter=Workflow&action=detail&name=card-dev) and a local authoring
	# tool needs nothing prettier. Without a router the application would not
	# start — nette/application requires it as a service.
	- Nette\Application\Routers\SimpleRouter(Workflow:default)

	# Latte can revalidate, it is just that LatteExtension ties it to debug
	# mode. Without this, a template would never recompile after an upgrade
	# — production does not check mtime, and Latte's version lives only in a
	# comment in the compiled file's header, not in its name. Setup from
	# configuration is appended after the extension's own, so it wins. The
	# price is a lock and a read of the template source on every render; on
	# a tool that runs on localhost, that is nothing.
	latte.latteFactory:
		setup:
			- setAutoRefresh(true)

session:
	# Without this, session.save_path from php.ini applies, to which an
	# unprivileged account usually cannot write — and a flash message after
	# saving would change to a warning from session_start(). %cacheDir% is the
	# user's directory, so sessions belong there; they are as disposable as the
	# compiled cache.
	savePath: %cacheDir%/sessions

	# php.ini's session.gc_probability is 0 on Debian-family distros, because
	# a cron job sweeps their managed session directory instead. Moving
	# savePath out of that directory inherits the zero without inheriting the
	# cleaner, so this directory would otherwise grow without bound.
	gcProbability: 1
