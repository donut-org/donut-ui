<!DOCTYPE html>
<html lang=en>
<meta charset=utf-8>
<meta name=viewport content="width=device-width, initial-scale=1">
<title>{block title}Donut{/block}</title>
<link rel=stylesheet href="/assets/bootstrap.min.css">
<link rel=stylesheet href="/assets/donut.css">

<div class="container-fluid">
	<div class="row">
		{*
			The left column is one element, not two: offcanvas-md means a
			slide-out panel below md, a plain column from md up. The
			navigation is therefore not written twice, and nothing switches
			in JS.
		*}
		<nav id=nav class="col-md-3 col-lg-2 offcanvas-md offcanvas-start bg-body-tertiary p-3" tabindex="-1" aria-label="Main navigation">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<a class="fs-4 fw-semibold text-decoration-none" n:href="Workflow:default">Donut</a>
				<button type=button class="btn-close d-md-none" data-bs-dismiss=offcanvas data-bs-target="#nav" aria-label="Close"></button>
			</div>

			{* Which set I'm currently editing. Without this the GUI says
			   nothing about the profile, and you mix it up only once —
			   silently, though. *}
			<div class="text-body-secondary small mb-3">Profile: <code>{$profile}</code></div>

			{* aria-current tells a screen reader the same thing the
			   highlighted item tells a sighted user. The active class
			   alone is just color. *}
			<ul class="nav nav-pills flex-column">
				<li class=nav-item>
					<a n:class="nav-link, isLinkCurrent('Workflow:*') ? active" n:attr="aria-current => isLinkCurrent('Workflow:*') ? 'page'" n:href="Workflow:default">Workflows</a>
				</li>
				<li class=nav-item>
					<a n:class="nav-link, isLinkCurrent('Block:*') ? active" n:attr="aria-current => isLinkCurrent('Block:*') ? 'page'" n:href="Block:default">Blocks</a>
				</li>
			</ul>
		</nav>

		<main class="col py-3 px-md-4">
			<div class="d-flex align-items-center gap-2 mb-3">
				<button type=button class="btn btn-outline-secondary d-md-none" data-bs-toggle=offcanvas data-bs-target="#nav" aria-label="Open navigation">☰</button>

				<nav aria-label="Breadcrumbs">
					<ol class="breadcrumb mb-0">
						{block breadcrumbs}<li class="breadcrumb-item active" aria-current=page>Donut</li>{/block}
					</ol>
				</nav>
			</div>

			{include content}
		</main>
	</div>
</div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/assets/rows.js"></script>
