{* Severity → CSS class and icon in one place, not duplicated twice. *}
{define problem, Donut\Validator\Problem $problem}
<div class="{$problem->severity === Donut\Validator\Problem::Error ? 'text-danger' : 'text-warning'}">
	{$problem->severity === Donut\Validator\Problem::Error ? '✕' : '⚠'} {$problem->message}
</div>
{/define}


{* The "writes" bar has the same shape for set and foreach, in one place, so
   the selected key's state (flow-on/flow-dim) only needs adding once. *}
{define writes, array $writes, ?string $selected}
<div n:if="$writes" n:class="alert, alert-info, flow,
	$selected !== null && in_array($selected, $writes, true) ? 'flow-on'
	: ($selected !== null ? 'flow-dim' : null)">writes
	{foreach $writes as $k}<a href="{plink this, key: $k}"><code>{$k}</code></a>{sep}, {/sep}{/foreach}
</div>
{/define}


{define steps, array $steps, Donut\Gui\StepPath $path, Donut\Gui\ProblemMap $problems, Donut\Gui\KeyMap $keys, ?string $selected, string $name}
<div class="chain">
	{foreach $steps as $i => $step}
		{var $at = $path->index($i)}
		{* How many steps disappear along with this one — recursively, including
		   nested then/else/steps, otherwise the delete confirmation would
		   understate the count. *}
		{var $subtree = Donut\Gui\StepCount::subtree($step)}
		{var $type = $step instanceof Donut\Format\RunStep ? 'run'
			: ($step instanceof Donut\Format\SetStep ? 'set'
			: ($step instanceof Donut\Format\IfStep ? 'if' : 'foreach'))}
		{var $typeClass = ['run' => 'text-bg-secondary', 'set' => 'text-bg-success',
			'if' => 'text-bg-dark', 'foreach' => 'text-bg-primary'][$type]}
		{var $reads = $keys->readsAt($at)}
		{var $writes = $keys->writesAt($at)}
		{* Empty means the step doesn't work with the selected key. With no
		   selected key, classAt() always returns empty, so nothing opens. *}
		{var $keyClass = $keys->classAt($at, $selected)}

		<div class="node">
			{* The class from classAt() belongs to the bubble. For a loop the
			   bubble contains its own body too, hence the extra class loop — CSS
			   then draws the ring only on the header, otherwise it would frame
			   the whole subtree inside. *}
			<div n:class="card, step, $type === 'foreach' ? 'loop' : null, $keyClass">
				<div class="card-header d-flex align-items-center gap-2 flex-wrap">
					<span n:class="badge, $typeClass">{$type}</span>
					<span n:if="$step->name" class="fw-medium">{$step->name}</span>
					{if $type === 'foreach'}
						<span class="text-muted small"><code>{$step->over->getSource()}</code>
							as <code>{$step->as}</code></span>
					{/if}
				</div>

				<div class="card-body">
					<div n:if="$reads" n:class="alert, alert-success, flow,
						$selected !== null && in_array($selected, $reads, true) ? 'flow-on'
						: ($selected !== null ? 'flow-dim' : null)">reads
						{foreach $reads as $k}<a href="{plink this, key: $k}"><code>{$k}</code></a>{sep}, {/sep}{/foreach}
					</div>

					{if $type === 'run'}
						{var $inputCount = count($step->in)}
						<details class="block" n:attr="open => $keyClass !== ''">
							<summary><code>{$step->block}</code>
								<span class="text-muted">· {if $inputCount === 0}no inputs{else}{$inputCount}
									{$inputCount === 1 ? 'input' : 'inputs'}{/if}</span>
							</summary>
							<div class="block-body">
								<div class="in-row" n:foreach="$step->in as $key => $template">
									<small class="fw-bold">{$key}</small>
									<code>{$template->getSource()}</code>
								</div>
								<p n:if="$inputCount === 0" class="text-muted small mb-0">The block has no inputs.</p>
							</div>
						</details>

						<div n:if="$step->out" n:class="alert, alert-info, flow,
							$selected !== null && in_array($selected, $writes, true) ? 'flow-on'
							: ($selected !== null ? 'flow-dim' : null)">
							{foreach $step->out as $channel => $key}{$channel} →
								<a href="{plink this, key: $key}"><code>{$key}</code></a>{sep}<br>{/sep}{/foreach}
						</div>

					{elseif $type === 'set'}
						<div class="alert alert-light flow"><code>{$step->value->getSource()}</code></div>
						{include writes, writes: $writes, selected: $selected}

					{elseif $type === 'if'}
						<div class="alert alert-light flow">
							<code>{$step->condition->left->getSource()}</code>
							<strong>{$step->condition->op}</strong>
							{if $step->condition->right}<code>{$step->condition->right->getSource()}</code>{/if}
						</div>

					{else}
						{include writes, writes: $writes, selected: $selected}
						<div class="loop-body">
							{include steps, steps: $step->steps, path: $at->child('steps'), problems: $problems, keys: $keys, selected: $selected, name: $name}
						</div>
					{/if}

					{foreach $problems->at($at) as $problem}
						{include problem, problem: $problem}
					{/foreach}
				</div>

				<div class="card-footer d-flex gap-1 align-items-center justify-content-end">
					{* btn-group doesn't work here: it expects buttons as direct
					   siblings, but three of the four each sit in their own <form>
					   — a Nette component can't render inside n:foreach, so the
					   forms have to stay manual. *}
					<a class="btn btn-sm btn-outline-secondary" href="{plink Workflow:step, name: $name, at: (string) $at}">edit</a>

					<form n:if="$i > 0" method=post action="{link moveUp!}" class="d-inline">
						<input type=hidden name=at value="{$at}">
						<button type=submit class="btn btn-sm btn-outline-secondary" aria-label="Move up">↑</button>
					</form>

					<form n:if="$i < count($steps) - 1" method=post action="{link moveDown!}" class="d-inline">
						<input type=hidden name=at value="{$at}">
						<button type=submit class="btn btn-sm btn-outline-secondary" aria-label="Move down">↓</button>
					</form>

					<form method=post action="{link deleteStep!}" class="d-inline">
						<input type=hidden name=at value="{$at}">
						<button type=submit class="btn btn-sm btn-outline-danger" aria-label="Delete step" n:attr="onclick => $subtree
							? 'return confirm(\'Delete this step and ' . Donut\Gui\StepCount::label($subtree) . '?\')'
							: null">×</button>
					</form>
				</div>
			</div>

			{* The if branches hang below the bubble, OUTSIDE it — unlike the
			   loop body, which is inside. The columns must be equally wide,
			   otherwise the horizontal connector wouldn't land on their centers
			   (CSS handles that). *}
			{if $type === 'if'}
				<div class="branches">
					<div class="branch">
						<h3 class="branch-label h6"><span class="badge text-bg-light border">then</span></h3>
						{include steps, steps: $step->then, path: $at->child('then'), problems: $problems, keys: $keys, selected: $selected, name: $name}
					</div>
					<div class="branch">
						<h3 class="branch-label h6"><span class="badge text-bg-light border">else</span></h3>
						{include steps, steps: $step->else, path: $at->child('else'), problems: $problems, keys: $keys, selected: $selected, name: $name}
					</div>
				</div>
			{/if}
		</div>
	{/foreach}

	<div class="add">+ step:
		{foreach ['run', 'set', 'if', 'foreach'] as $newType}
			<a href="{plink Workflow:step, name: $name, at: (string) $path->index(count($steps)), type: $newType}">{$newType}</a>{sep} {/sep}
		{/foreach}
	</div>
</div>
{/define}
