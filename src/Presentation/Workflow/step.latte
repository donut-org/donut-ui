{block title}Step — {$name} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Workflow:default">Workflows</a></li>
	<li class=breadcrumb-item><a n:href="Workflow:detail, name: $name">{$name}</a></li>
	<li class="breadcrumb-item active" aria-current=page>step</li>
{/block}

{block content}
<h1>Step {$type}</h1>
<p class=keys>{$at}</p>

<p n:if="$error" class="alert alert-danger">{$error}</p>

{if !$error}
	{form stepForm}
		<div n:if="$form->getErrors()" class="alert alert-danger">
			<ul class="mb-0">
				<li n:foreach="$form->getErrors() as $err">{$err}</li>
			</ul>
		</div>

		<div class="card mb-3">
			<div class="card-body">
				{input type}
				<p>{label name /} {input name}</p>

				{if $type === 'run'}
					<p>{label block /} {input block}</p>

				{elseif $type === 'set'}
					<p>{label key /} {input key}</p>
					<p>{label value /} {input value}</p>

				{elseif $type === 'if'}
					<p>{label left /} {input left} {input op} {input right}</p>
					<p class=keys>Operators <code>empty</code> and <code>not_empty</code> ignore the right side.</p>

				{elseif $type === 'foreach'}
					<p>{label over /} {input over}</p>
					<p>{label as /} {input as}</p>
				{/if}
			</div>
		</div>

		{if $type === 'run'}
			<div class="card mb-3">
				<div class="card-header">Block inputs</div>
				<div class="card-body">
					{* table-responsive and aria-label literally like in
					   Workflow/edit.latte. *}
					<div class=table-responsive>
						<table class="table table-sm align-middle">
							<thead>
								<tr>
									<th scope=col>Block input</th>
									<th scope=col>Value or <code>{='{%key%}'}</code></th>
									<th scope=col><span class=visually-hidden>Delete row</span></th>
								</tr>
							</thead>
							<tbody id=in>
								<tr class=js-row n:foreach="$form['in']->getComponents() as $row">
									<td>{input $row['key']}</td>
									<td>{input $row['value']}</td>
									<td><button type=button class="btn btn-sm btn-outline-danger js-del-row" aria-label="Delete row">×</button></td>
								</tr>
							</tbody>
						</table>
					</div>

					<button type=button class="btn btn-sm btn-secondary" data-add=in>+ input</button>
				</div>
			</div>

			<div class="card mb-3">
				<div class="card-header">Outputs to the map</div>
				<div class="card-body">
					<div class=table-responsive>
						<table class="table table-sm align-middle">
							<thead>
								<tr>
									<th scope=col>Block output</th>
									<th scope=col>Map key</th>
									<th scope=col><span class=visually-hidden>Delete row</span></th>
								</tr>
							</thead>
							<tbody id=out>
								<tr class=js-row n:foreach="$form['out']->getComponents() as $row">
									<td>{input $row['channel']}</td>
									<td>{input $row['value']}</td>
									<td><button type=button class="btn btn-sm btn-outline-danger js-del-row" aria-label="Delete row">×</button></td>
								</tr>
							</tbody>
						</table>
					</div>

					<button type=button class="btn btn-sm btn-secondary" data-add=out>+ output</button>
				</div>
			</div>

			<div class="card mb-3">
				<div class="card-header">Other</div>
				<div class="card-body">
					<p>{label timeout /} {input timeout}</p>
					<p>{label allowFailure /} {input allowFailure} {input allowFailureCodes}</p>
				</div>
			</div>
		{/if}

		<p>{input save}</p>
	{/form}
{/if}
