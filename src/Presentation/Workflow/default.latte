{block title}Workflow — Donut{/block}

{block breadcrumbs}
	<li class="breadcrumb-item active" aria-current=page>Workflow</li>
{/block}

{block content}
<h1>Workflow</h1>

<p><a n:href="Workflow:edit">+ nové workflow</a></p>

<p n:if="$error" class=error>{$error}</p>
<p n:if="!$error && !$workflows">V adresáři <code>{$dir}</code> žádná workflow nejsou.</p>

<ul n:if="$workflows">
	<li n:foreach="$workflows as $name => $workflow">
		{* Odkaz na úpravu je mimo podmínku schválně: workflow, které se
		   nenaparsuje, je ten jediný, u kterého uživatel cestu k opravě
		   a k mazání potřebuje nejvíc. Stejně to má Block/default.latte. *}
		{if is_string($workflow)}
			<strong>{$name}</strong> — <span class=error>{$workflow}</span>
		{else}
			<a n:href="detail $name">{$name}</a>
			{$workflow->description}
		{/if}
		<a n:href="Workflow:edit, name: $name">upravit</a>
	</li>
</ul>
