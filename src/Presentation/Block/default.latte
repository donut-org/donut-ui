{block title}Kameny — Donut{/block}

{block breadcrumbs}
	<li class="breadcrumb-item active" aria-current=page>Kameny</li>
{/block}

{block content}
<h1>Kameny</h1>

<p><a n:href="Block:edit" class="btn btn-primary">+ nový kámen</a></p>

{* Hláška i s návodem `mkdir blocks` přichází hotová z renderDefault(),
   stejně jako na Workflow:detail. *}
<p n:if="$error" class=error>{$error}</p>
<p n:if="!$error && !$blocks">V adresáři <code>{$dir}</code> žádné kameny nejsou.</p>

<div class=table-responsive n:if="$blocks">
	<table class="table table-sm align-middle">
		<thead>
			<tr>
				<th scope=col>Jméno</th>
				{* Popis je druhý sloupec stejně jako u workflow: příkaz sám kameny
				   nerozliší (v reálném projektu ho sdílí 9 z 15), popis ano. *}
				<th scope=col>Popis</th>
				<th scope=col>Příkaz</th>
				<th scope=col>Používá</th>
				<th scope=col><span class=visually-hidden>Akce</span></th>
			</tr>
		</thead>
		<tbody>
			<tr n:foreach="$blocks as $name => $block">
				<td>
					{if is_string($block)}
						<strong>{$name}</strong>
					{else}
						<a n:href="Block:detail, name: $name">{$name}</a>
					{/if}
				</td>
				{* Hláška rozbitého kamene sedí ve druhém sloupci, stejně jako
				   u rozbitého workflow; ostatní sloupce zůstanou u takového
				   řádku prázdné, protože se nemají odkud vzít. *}
				<td>
					{if is_string($block)}
						<span class=error>{$block}</span>
					{else}
						{$block->description}
					{/if}
				</td>
				<td>
					{if !is_string($block)}
						<code>{$block->command}</code>
					{/if}
				</td>
				<td>{if isset($usage[$name])}{implode(', ', $usage[$name])}{/if}</td>
				{* Odkaz na úpravu je mimo podmínku schválně: kámen, který se
				   nenaparsuje, je ten jediný, u kterého uživatel cestu k opravě
				   a k mazání potřebuje nejvíc. Stejně to má Workflow/default.latte.

				   aria-label rozlišuje odkazy mezi sebou: v seznamu odkazů
				   odečítače obrazovky je jinak tolikrát „upravit", kolik má
				   tabulka řádků, a který je který, z něj nepoznáš. Laťku
				   nastavil aria-label="Smazat řádek" u řádkových tlačítek. *}
				<td><a n:href="Block:edit, name: $name" class="btn btn-primary btn-sm" aria-label="Upravit kámen {$name}">upravit</a></td>
			</tr>
		</tbody>
	</table>
</div>
