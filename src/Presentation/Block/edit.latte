{block title}{$name ?? 'New block'} — Donut{/block}

{block breadcrumbs}
	<li class=breadcrumb-item><a n:href="Block:default">Blocks</a></li>
	<li n:if="$name !== null" class=breadcrumb-item><a n:href="Block:detail, name: $name">{$name}</a></li>
	<li class="breadcrumb-item active" aria-current=page>{$name === null ? 'new block' : 'edit'}</li>
{/block}

{block content}
<h1>{$name ?? 'New block'}</h1>

<p n:if="$error" class="alert alert-danger">{$error}</p>

{if !$error}
	<div n:if="$errors" class="alert alert-danger">
		<ul class="mb-0">
			<li n:foreach="$errors as $err">{$err}</li>
		</ul>
	</div>

	<div n:if="$warnings" class="alert alert-warning">
		<ul class="mb-0">
			<li n:foreach="$warnings as $warning">{$warning}</li>
		</ul>
	</div>

	{form blockForm}
		<div n:if="$form->getErrors()" class="alert alert-danger">
			<ul class="mb-0">
				<li n:foreach="$form->getErrors() as $err">{$err}</li>
			</ul>
		</div>

		<div class="card mb-3">
			<div class="card-body">
				<p>{label name /} {input name}</p>
				<p>{label description /} {input description}</p>
				<p>{label command /} {input command}</p>
			</div>
		</div>

		{* What the block declares comes first — inputs, then stdin — and
		   only then what uses it. An argument is written in terms of the
		   inputs ({%name%}), so the list they come from has to be readable
		   first; the other way round the reader meets the placeholders
		   before anything that says what they are. *}
		<div class="card mb-3">
			<div class="card-header">Inputs</div>
			<div class="card-body">
				{* table-responsive and aria-label literally like in
				   Workflow/edit.latte — it's the same inputs table. *}
				<div class=table-responsive>
					<table class="table table-sm align-middle">
						<thead>
							<tr>
								<th scope=col>Name</th>
								<th scope=col>Required</th>
								<th scope=col>Default</th>
								<th scope=col>Description</th>
								<th scope=col><span class=visually-hidden>Delete row</span></th>
							</tr>
						</thead>
						<tbody id=inputs>
							<tr class=js-row n:foreach="$form['inputs']->getComponents() as $row">
								<td>{input $row['name']}</td>
								<td>{input $row['required']}</td>
								<td>{input $row['default']}</td>
								<td>{input $row['description']}</td>
								<td><button type=button class="btn btn-sm btn-outline-danger js-del-row" aria-label="Delete row">×</button></td>
							</tr>
						</tbody>
					</table>
				</div>

				<button type=button class="btn btn-sm btn-secondary" data-add=inputs>+ input</button>

				<p class=form-text>
					The default value is used when the caller does not pass one.
					On the command line an input is given as <code>--name=value</code>.
				</p>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Stdin</div>
			<div class="card-body">
				<p>{label stdin /} {input stdin}</p>
				{* The id is what the select's toggle() addresses; without it
				   netteForms.js has nothing to show or hide. *}
				<p id=stdin-description>{label stdinDescription /} {input stdinDescription}</p>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Arguments</div>
			<div class="card-body">
				<p class=keys>A group where a variable evaluates to empty is dropped whole.</p>

				{* Horizontal group shape: form-control from FormFactory is
				   display:block full width, so without this the arguments would
				   be a vertical column of identical-looking fields and the group
				   boundary would disappear. The class is written out in full
				   including form-control — the guard in FormFactory (adds the
				   class only where none is present) doesn't apply here, because
				   {input} with a class => … attribute overwrites the whole class;
				   if form-control were missing from this string, it would be
				   missing from the HTML too. *}
				<div id=args>
					<div class="arg-group d-flex flex-wrap align-items-center gap-2 mb-2 border rounded p-2" n:foreach="$form['args']->getComponents() as $group">
						<span n:foreach="$group->getComponents() as $arg">{input $arg, class => 'form-control w-auto'}</span>
						<button type=button class="btn btn-sm btn-secondary add-arg">+ argument</button>
						<button type=button class="btn btn-sm btn-outline-danger del-group">× group</button>
					</div>
				</div>

				<button type=button class="btn btn-sm btn-secondary" id=add-group>+ group</button>
			</div>
		</div>

		<div class="card mb-3">
			<div class="card-header">Other</div>
			<div class="card-body">
				<p>{label timeout /} {input timeout}</p>
				<p>{label allowFailure /} {input allowFailure} {input allowFailureCodes}</p>
			</div>
		</div>

		<p>{input save}</p>
	{/form}

	{* Argument groups are two-level (args[g][a]) — the shared mechanism from
	   rows.js only handles one level, so args stays on its own code. It does
	   use its maxIndex and cloneRow though. *}
	<script n:syntax="off">
	document.getElementById('add-group').addEventListener('click', () => {
		const box = document.getElementById('args');
		const rows = box.querySelectorAll('.arg-group');
		const next = maxIndex(box.querySelectorAll('input'), /^args\[(\d+)]/) + 1;
		box.appendChild(cloneRow(
			rows[rows.length - 1],
			n => n.replace(/^args\[\d+]/, 'args[' + next + ']')
		));
	});

	document.addEventListener('click', e => {
		if (e.target.classList.contains('add-arg')) {
			const group = e.target.closest('.arg-group');
			const first = group.querySelector('span');
			const g = /^args\[(\d+)]/.exec(first.querySelector('input').getAttribute('name'))[1];
			const next = maxIndex(group.querySelectorAll('input'), /^args\[\d+]\[(\d+)]/) + 1;
			group.insertBefore(
				cloneRow(first, n => 'args[' + g + '][' + next + ']'),
				e.target
			);
		}

		if (e.target.classList.contains('del-group')) {
			const box = document.getElementById('args');
			if (box.querySelectorAll('.arg-group').length > 1) e.target.closest('.arg-group').remove();
		}
	});
	</script>
{/if}

{if $name !== null}
	<div class="card border-danger mb-3">
		<div class="card-header text-danger">Delete</div>
		<div class="card-body">
			{if $usedBy}
				<p class=keys>
					Cannot be deleted — used by: {implode(', ', $usedBy)}.
				</p>
			{else}
				{form deleteForm}
					<div n:if="$form->getErrors()" class="alert alert-danger">
						<ul class="mb-0">
							<li n:foreach="$form->getErrors() as $err">{$err}</li>
						</ul>
					</div>

					<input type=hidden n:name=name value="{$name}">
					{* The name isn't passed to confirm() on purpose: Latte
					   JSON-encodes a value in a JS context, and the dialog would
					   have it in extra quotes. Escaping isn't disabled, the text
					   was reworded instead. *}
					<button type=submit n:name=delete onclick="return confirm('Really delete this block?')">Delete</button>
				{/form}
			{/if}
		</div>
	</div>
{/if}
